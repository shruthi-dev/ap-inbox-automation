# Copy to supabase/functions/.env, fill in, then:  npx supabase secrets set --env-file supabase/functions/.env
# Never commit the filled-in .env file.

# Claude API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Entra app registration for Microsoft Graph (application permissions Mail.Read + Mail.Send, admin consented)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Any long random string; the same value goes into Vault as 'cron_secret'
CRON_SECRET=
